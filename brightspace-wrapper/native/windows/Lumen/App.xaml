             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Fg" Color="#1A1A22" />
        <SolidColorBrush x:Key="Muted" Color="#6B6B76" />
